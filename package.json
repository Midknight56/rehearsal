{
  "name": "rehearsal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:model": "vitest run --passWithNoTests",
    "test:ui": "vitest run --config vitest.ui.config.ts --passWithNoTests",
    "test:e2e": "playwright test",
    "test:video": "playwright test --config playwright.video.config.ts",
    "build": "vite build",
    "verify": "npm run typecheck && npm run test:model && npm run test:ui && npm run build"
  },
  "dependencies": {
    "papaparse": "5.7.0",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "seedrandom": "3.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/seedrandom": "3.0.8",
    "@vitejs/plugin-react": "6.3.0",
    "fast-check": "4.10.2",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
